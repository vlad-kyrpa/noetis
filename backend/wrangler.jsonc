{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noetis",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-05",

  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
