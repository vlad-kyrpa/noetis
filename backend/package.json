{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --env-interface CloudflareBindings",
    "test": "tsx --test src/**/*.test.ts",
    "test:e2e": "tsx --test src/e2e/**/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply noetis --local",
    "db:migrate:remote": "wrangler d1 migrations apply noetis --remote",
    "build:client": "npm --prefix ../client run build",
    "deploy": "npm run build:client && wrangler deploy"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  }
}
